# ─────────────────────────────────────────────────────────────────────────────
# .env.example  —  SAFE TO COMMIT.  Never commit the actual .env file.
#
# How to use:
#   1. Copy this file:  cp .env.example .env
#   2. Fill in real values inside .env
#   3. .env is listed in .gitignore — it will never be committed
#
# CI/CD (GitHub Actions):
#   Do NOT create a .env file in CI.
#   Instead, go to: Settings → Secrets and variables → Actions → New repository secret
#   Add each secret below (UAT_VENDOR_EMAIL, UAT_VENDOR_PASSWORD, EMAIL_PASSWORD).
#   The prod-sanity.yml workflow injects them as env vars automatically.
#
# Security rules:
#   - Never hardcode real credentials in any Java source file
#   - Never print credential values in logs or test reports
#   - Use dedicated test accounts — never real user/admin passwords
# ─────────────────────────────────────────────────────────────────────────────

# Vendor portal login
UAT_VENDOR_URL=https://uat-vendor.embtalent.ai/login
UAT_VENDOR_EMAIL=sanityvendor@yopmail.com
UAT_VENDOR_PASSWORD=Emb@1234

# Requirement to open in the sanity test
UAT_REQ_NAME=Dont Touch Test Sanity Requirement

# Resume file to upload (relative to project root)
UAT_RESUME_PATH=src/test/resources/Shashikant.pdf

# Email report delivery (used by EmailSender)
EMAIL_PASSWORD=your_gmail_app_password